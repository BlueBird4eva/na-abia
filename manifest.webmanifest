{
  "id": "/",
  "name": "NaAbia — Navigate Abia, Local Guide",
  "short_name": "NaAbia",
  "description": "Offline local guide for all 17 LGAs of Abia State — villages, schools, hospitals, markets, NYSC & emergency contacts.",
  "lang": "en",
  "dir": "ltr",
  "start_url": "./index.html",
  "scope": "./",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "orientation": "portrait",
  "background_color": "#12281B",
  "theme_color": "#173620",
  "categories": ["travel", "navigation", "utilities", "lifestyle"],
  "prefer_related_applications": false,
  "launch_handler": { "client_mode": "navigate-existing" },
  "icons": [
    { "src": "icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icon-512-maskable.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "screenshots": [
    {
      "src": "screenshot-narrow.png",
      "sizes": "390x844",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "Explore places across all 17 LGAs of Abia State"
    },
    {
      "src": "screenshot-wide.png",
      "sizes": "1280x800",
      "type": "image/png",
      "form_factor": "wide",
      "label": "NaAbia on a larger screen"
    }
  ],
  "shortcuts": [
    {
      "name": "Send SOS",
      "short_name": "SOS",
      "description": "Send your location to trusted contacts",
      "url": "./index.html?action=sos",
      "icons": [{ "src": "icon-192.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "Search places",
      "short_name": "Search",
      "description": "Search the guide",
      "url": "./index.html?action=search",
      "icons": [{ "src": "icon-192.png", "sizes": "192x192", "type": "image/png" }]
    }
  ]
}
